<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Compendium.Adapters.Supabase.Management</AssemblyName>
    <RootNamespace>Compendium.Adapters.Supabase.Management</RootNamespace>
    <PackageId>Compendium.Adapters.Supabase.Management</PackageId>
    <Description>Control-plane companion to Compendium.Adapters.Supabase. A stateless ISupabaseAdmin facade over the Supabase Cloud Management API (project create / get / delete, project API keys) and the Storage admin API (bucket create / list / delete), plus a bring-your-own / self-hosted attach probe. Every call takes an explicit, redacting SupabaseConnection and returns the Result pattern; capabilities gate cloud vs self-hosted vs keys-only.</Description>
    <PackageTags>compendium;adapter;supabase;management;provisioning;buckets;control-plane</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Compendium.Adapters.Supabase\Compendium.Adapters.Supabase.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Compendium.Abstractions" />
    <PackageReference Include="Compendium.Core" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Compendium.Adapters.Supabase.Management.Tests" />
  </ItemGroup>

</Project>
