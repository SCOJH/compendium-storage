<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Compendium.Storage.Encryption</AssemblyName>
    <RootNamespace>Compendium.Storage.Encryption</RootNamespace>
    <PackageId>Compendium.Storage.Encryption</PackageId>
    <Description>Envelope encryption for Compendium object storage: an EncryptingObjectStore decorator over any IObjectStore. Per-object data keys wrapped by a per-tenant key-encryption key (IKeyEncryptionKeyProvider), streamed AES-256-GCM in 64 KiB blocks, constant-memory verified reads, truncation and reordering detected.</Description>
    <PackageTags>compendium;object-storage;storage;encryption;envelope-encryption;aes-gcm;decorator</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Compendium.Abstractions.Storage\Compendium.Abstractions.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Compendium.Abstractions" />
    <PackageReference Include="Compendium.Core" />
    <PackageReference Include="Compendium.Multitenancy" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Compendium.Storage.Encryption.Tests" />
  </ItemGroup>

</Project>
