<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Compendium.Adapters.Supabase</AssemblyName>
    <RootNamespace>Compendium.Adapters.Supabase</RootNamespace>
    <PackageId>Compendium.Adapters.Supabase</PackageId>
    <Description>Compendium adapter for Supabase Storage (cloud and self-hosted). Implements the IObjectStore port over the native Supabase Storage REST API with tenant-scoped keys, streaming uploads, presigned download URLs, signed upload URLs, public URLs, and image transforms. Ships a per-connection storage factory and a redacting credential model for multi-project platforms.</Description>
    <PackageTags>compendium;adapter;supabase;object-storage;storage;blob</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Compendium.Abstractions.Storage\Compendium.Abstractions.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Compendium.Abstractions" />
    <PackageReference Include="Compendium.Core" />
    <PackageReference Include="Compendium.Multitenancy" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Compendium.Adapters.Supabase.Tests" />
    <InternalsVisibleTo Include="Compendium.Adapters.Supabase.IntegrationTests" />
    <InternalsVisibleTo Include="Compendium.Adapters.Supabase.Management" />
    <InternalsVisibleTo Include="Compendium.Adapters.Supabase.Management.Tests" />
  </ItemGroup>

</Project>
